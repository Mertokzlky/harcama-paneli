rules_version = '2';

// Her kullanıcı yalnızca kendi işlemlerini okuyup yazabilir; alanlar sunucu tarafında doğrulanır.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/transactions/{txId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isValid(d) {
        return d.keys().hasOnly(['type', 'amountMinor', 'category', 'date', 'note', 'createdAt', 'updatedAt'])
          && d.type in ['income', 'expense']
          && d.amountMinor is int && d.amountMinor > 0 && d.amountMinor <= 99999999999
          && d.category is string && d.category.size() > 0 && d.category.size() <= 40
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.note is string && d.note.size() <= 200
          && d.createdAt is timestamp;
      }

      allow read: if isOwner();
      allow create: if isOwner() && isValid(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if isOwner() && isValid(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();
    }

    // Diğer her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
